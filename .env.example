# Server-side only. Copy to .env.local; do not commit credentials.
# Delivery remains pending until all four fields are configured.
RESEND_API_KEY=
INQUIRY_TO_EMAIL=
# Verified sender address or verified-domain sender identity:
INQUIRY_FROM_EMAIL=
# Random server secret of at least 32 bytes, used to sign anti-spam tokens:
INQUIRY_TOKEN_SECRET=
# Exact public origin, no trailing slash. Local development defaults to request origin.
INQUIRY_ALLOWED_ORIGIN=
